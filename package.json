{
  "name": "picot",
  "version": "0.5.0-rc.1",
  "description": "Local Codex-style desktop GUI for the Pi coding agent",
  "keywords": [
    "picot",
    "pi",
    "coding-agent",
    "desktop",
    "multi-agent",
    "tauri"
  ],
  "author": "deflating",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shixin-guo/picot.git"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "bun run fetch:pi && bun run fetch:terminal-font && bun run fetch:cjk-font && bun run build:extensions && bun run build:frontend && PATH=\"$HOME/.cargo/bin:$PATH\" tauri dev --config src-tauri/tauri.dev.conf.json",
    "fetch:pi": "bun run scripts/fetch-pi-binary.js",
    "fetch:terminal-font": "bun run scripts/fetch-terminal-font.js",
    "fetch:cjk-font": "bun run scripts/fetch-cjk-font.js",
    "smoke:pi-rpc": "bun run scripts/smoke-pi-rpc.js",
    "smoke:gate-c": "bun run scripts/gate-c-parity-smoke.mjs",
    "smoke:host-origin-p3": "bun run scripts/smoke-host-origin-p3.mjs",
    "build:extensions": "bun run scripts/build-extensions.js",
    "sign:pi": "bash scripts/sign-pi-resources.sh",
    "build:frontend": "node scripts/build-frontend.js",
    "build:frontend:watch": "node scripts/build-frontend.js --watch",
    "build": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build",
    "prebuild": "bun run fetch:pi && bun run fetch:terminal-font && bun run fetch:cjk-font && bun run build:extensions && bun run build:frontend && bun run sign:pi",
    "release": "bash scripts/release.sh",
    "release:mac:dmg": "bash scripts/release-macos-dmg.sh",
    "test": "bun run test:safety && bun scripts/test-sandbox.js --command bun run build:frontend && bun scripts/test-sandbox.js run && bun scripts/test-sandbox.js --command bun scripts/check-tauri-permissions.js",
    "test:focused": "bun scripts/test-sandbox.js run",
    "test:safety": "bun scripts/test-sandbox-check.js",
    "test:coverage": "bun scripts/test-sandbox.js --command bun run build:frontend && bun scripts/test-sandbox.js run --coverage && bun scripts/test-sandbox.js --command bun scripts/check-tauri-permissions.js",
    "prepare": "husky",
    "test:watch": "bun scripts/test-sandbox.js watch",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write . --unsafe",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check . && bun run check:design",
    "check:fix": "biome check --write . --unsafe --formatter-enabled=false --linter-enabled=false && bun run check:design:fix",
    "check:design": "bun scripts/check-design-css.mjs",
    "check:design:fix": "bun scripts/check-design-css.mjs --fix",
    "check:permissions": "bun run scripts/check-tauri-permissions.js",
    "migration:inventory": "bun run scripts/migration-inventory.mjs",
    "check:inventory": "bun run scripts/check-migration-inventory.mjs",
    "rehearsal:recovery": "bun run scripts/recovery-rehearsal.mjs --out docs/superpowers/specs/2026-08-28-registry-runtime-recovery-rehearsal.md",
    "check:rehearsal": "bun run scripts/recovery-rehearsal.mjs --check",
    "perf:p3": "bun run scripts/perf-p3.mjs",
    "check:rust": "bash scripts/check-rust.sh"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-yaml": "6.1.2",
    "@codemirror/language": "6.12.2",
    "@codemirror/legacy-modes": "6.5.2",
    "@codemirror/search": "6.6.0",
    "@codemirror/state": "6.5.4",
    "@codemirror/theme-one-dark": "6.1.3",
    "@lezer/highlight": "1.2.3",
    "@codemirror/view": "6.39.13",
    "@earendil-works/pi-ai": "^0.84.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6",
    "chart.js": "4.4.3",
    "ignore": "^7.0.6",
    "minimatch": "^10.2.5",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.0",
    "remend": "^1.3.0",
    "ws": "^8.16.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@tauri-apps/cli": "^2.11.2",
    "@vitest/coverage-istanbul": "3.2.4",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "ttf2woff2": "8.0.1",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
